#!/bin/sh
# Force LuCI to invalidate browser JS/CSS caches after a firmware upgrade.
#
# LuCI builds its resource version stamp from:
#   stat('/lib/apk/db/installed').mtime  (see /usr/share/ucode/luci/runtime.uc)
# The URL is served as /luci-static/resources/luci.js?v=<stamp> from
# /usr/share/ucode/luci/template/header.ut. If that mtime does not change
# between sysupgrade images, the browser keeps serving the OLD cached view
# modules (e.g. pon/config.js, pon/status.js) even though the firmware has
# newer JS on disk -- giving the "changes had no effect" symptom.
#
# uci-defaults run once on first boot after every flash (including a
# preserve-config sysupgrade), so touching the package DB here guarantees a
# fresh version stamp and a clean reload of all LuCI assets.
touch /lib/apk/db/installed 2>/dev/null || true
touch /usr/lib/opkg/status 2>/dev/null || true

exit 0
